android_library {
    name: "Launcher3FeedLib",

    platform_apis: true,

    srcs: [
        "core/src/main/aidl/**/*.aidl",
        "core/src/main/java/**/*.kt",
    ],

    aidl: {
        local_include_dirs: ["core/src/main/aidl"],
        export_include_dirs: ["core/src/main/aidl"],
    },

    static_libs: [
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
    ],

    resource_dirs: ["core/src/main/res"],
    manifest: "core/src/main/AndroidManifest.xml",
}

android_app {
    name: "Launcher3FeedHelloWorld",
    defaults: ["platform_app_defaults"],

    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,

    srcs: [
        "helloworld/src/main/java/**/*.java",
        "helloworld/src/main/java/**/*.kt",
    ],

    static_libs: [
        "Launcher3FeedLib",
    ],

    resource_dirs: ["helloworld/src/main/res"],
    manifest: "helloworld/src/main/AndroidManifest.xml",

    optimize: {
        enabled: false,
    },
}

// Glancehub bridge for lockscreen widgets
// Requires: https://github.com/danascape/platform_frameworks_base/commit/cb69df1fbe126aa771fcd0986965a19d320d6e11
android_app {
    name: "Launcher3FeedGlance",
    defaults: ["platform_app_defaults"],

    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,

    srcs: [
        "glance/src/main/java/**/*.java",
        "glance/src/main/java/**/*.kt",
    ],

    static_libs: [
        "Launcher3FeedLib",
        "SystemUISharedLib",
    ],

    resource_dirs: ["glance/src/main/res"],
    manifest: "glance/src/main/AndroidManifest.xml",

    optimize: {
        enabled: false,
    },
}
